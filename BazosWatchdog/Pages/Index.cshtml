@page
@model IndexModel
@{
    ViewData["Title"] = "Queries";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Watched queries</h1>
        <p class="text-muted mb-0">Bazos.cz is checked at 08:00, 14:00, and 20:00 Europe/Prague time.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Queries/Create">Add query</a>
</div>

@if (Model.Queries.Count == 0)
{
    <div class="alert alert-secondary">No queries yet. Add a Bazos.cz search URL to start monitoring listings.</div>
}
else
{
    <div class="list-group">
    @foreach (var query in Model.Queries)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
           asp-page="/Queries/Details" asp-route-id="@query.Id">
            <span>
                <strong>@query.Name</strong>
                <span class="d-block text-muted text-truncate query-url">@query.SearchUrl</span>
            </span>
            <span class="badge text-bg-primary rounded-pill">@query.RecentListingCount new</span>
        </a>
    }
    </div>
}
</div>
